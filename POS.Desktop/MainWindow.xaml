<ui:FluentWindow x:Class="POS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:POS.Desktop" xmlns:views="clr-namespace:POS.Desktop.Views"
    Title="MiPOS — Gestión offline" Width="1280" Height="820" MinWidth="1040" MinHeight="680"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" WindowStartupLocation="CenterScreen" Background="{StaticResource GroundBrush}">
<Window.Resources><local:SectionVisibilityConverter x:Key="SectionVisibility"/></Window.Resources>
<Window.InputBindings>
<KeyBinding Key="F1" Command="{Binding NavigateCommand}" CommandParameter="0"/>
<KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="1"/>
<KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="2"/>
<KeyBinding Key="F5" Command="{Binding NavigateCommand}" CommandParameter="3"/>
</Window.InputBindings>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.RowSpan="2" Background="{StaticResource SidebarGradient}"/>
<ui:TitleBar Grid.ColumnSpan="2" Title="MiPOS — Gestión offline" ShowHelp="False"/>

<DockPanel Grid.Row="1" Margin="14,0,14,16">
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,22">
<Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource StrongGradient}"><ui:SymbolIcon Symbol="ShoppingBag24" Foreground="White" FontSize="20"/></Border>
<StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="MiPOS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Gestión offline" FontSize="12" Foreground="#3E5A64"/></StackPanel>
</StackPanel>

<Border DockPanel.Dock="Bottom" CornerRadius="10" Background="#B3FFFFFF" Padding="12">
<StackPanel>
<DockPanel Margin="0,0,0,8">
<ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding BackupSymbol}" Foreground="{Binding BackupBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top"/>
<TextBlock Text="{Binding BackupStatus}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"/>
</DockPanel>
<ui:Button x:Name="BackupMenuButton" Content="Respaldos…" HorizontalAlignment="Stretch" Click="BackupMenuClick" AutomationProperties.Name="Respaldos: exportar o restaurar">
<ui:Button.ContextMenu><ContextMenu>
<MenuItem Header="Exportar respaldo…" Command="{Binding BackupCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowUpload24"/></MenuItem.Icon></MenuItem>
<MenuItem Header="Restaurar respaldo…" Command="{Binding RestoreCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></MenuItem.Icon></MenuItem>
</ContextMenu></ui:Button.ContextMenu>
</ui:Button>
</StackPanel>
</Border>

<ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}" SelectedIndex="{Binding Section}" AutomationProperties.Name="Secciones">
<ListBoxItem AutomationProperties.Name="Nueva venta"><DockPanel><ui:SymbolIcon Symbol="Cart24" FontSize="20" Margin="0,0,12,0"/><TextBlock DockPanel.Dock="Right" Text="F1" Style="{StaticResource ShortcutHint}"/><TextBlock Text="Nueva venta" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
<ListBoxItem AutomationProperties.Name="Productos"><DockPanel><ui:SymbolIcon Symbol="BoxMultiple24" FontSize="20" Margin="0,0,12,0"/><TextBlock DockPanel.Dock="Right" Text="F3" Style="{StaticResource ShortcutHint}"/><TextBlock Text="Productos" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
<ListBoxItem AutomationProperties.Name="Inventario"><DockPanel><ui:SymbolIcon Symbol="BoxCheckmark24" FontSize="20" Margin="0,0,12,0"/>
<Border DockPanel.Dock="Right" Background="{StaticResource DangerInkBrush}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center" Visibility="{Binding AlertVisibility}" ToolTip="Productos con stock bajo o para reponer"><TextBlock Text="{Binding AlertCount}" FontSize="12" FontWeight="Bold" Foreground="White"/></Border>
<TextBlock Text="Inventario" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
<ListBoxItem AutomationProperties.Name="Historial"><DockPanel><ui:SymbolIcon Symbol="Receipt24" FontSize="20" Margin="0,0,12,0"/><TextBlock DockPanel.Dock="Right" Text="F5" Style="{StaticResource ShortcutHint}"/><TextBlock Text="Historial" VerticalAlignment="Center"/></DockPanel></ListBoxItem>
</ListBox>
</DockPanel>

<Grid Grid.Row="1" Grid.Column="1">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<ui:InfoBar Margin="26,6,26,0" Title="{Binding MessageTitle}" Message="{Binding Message}" Severity="{Binding MessageSeverity}" IsOpen="{Binding HasMessage,Mode=TwoWay}" IsClosable="True" AutomationProperties.LiveSetting="Polite"/>
<views:SalePage x:Name="SalePageView" Grid.Row="1" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=0}"/>
<views:ProductsPage Grid.Row="1" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=1}"/>
<views:InventoryPage Grid.Row="1" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=2}"/>
<views:HistoryPage Grid.Row="1" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=3}"/>
</Grid>
</Grid>
</ui:FluentWindow>
