<Window x:Class="POS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MiPOS — Gestión offline" Width="1220" Height="820" MinWidth="1000" MinHeight="680">
<DockPanel Margin="18">
<Grid DockPanel.Dock="Top" Margin="4,0,4,12"><TextBlock Text="MiPOS" FontSize="28" FontWeight="Bold" Foreground="#17365D"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Exportar respaldo" Command="{Binding BackupCommand}"/><Button Content="Restaurar respaldo" Command="{Binding RestoreCommand}"/></StackPanel></Grid>
<Border DockPanel.Dock="Bottom" Background="#E1EAF8" Padding="10" Margin="4"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
<TabControl>
<TabItem Header="Nueva venta">
<Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Grid.Column="0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Buscar por nombre o código"/><TextBox x:Name="SaleSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar producto"/><StackPanel Orientation="Horizontal"><TextBlock Text="Cantidad" VerticalAlignment="Center"/><TextBox Width="110" Text="{Binding SaleQuantity}" AutomationProperties.Name="Cantidad a vender"/><Button Content="Agregar al carrito" Command="{Binding AddCartCommand}"/></StackPanel><TextBlock Text="Usá kg para peso (ej.: 0,5); unidades o packs enteros." FontSize="13" TextWrapping="Wrap"/></StackPanel>
<DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Precio" Binding="{Binding Price}"/><DataGridTextColumn Header="Por" Binding="{Binding UnitLabel}"/></DataGrid.Columns></DataGrid></DockPanel>
<DockPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock DockPanel.Dock="Top" Text="Carrito" FontSize="22" FontWeight="SemiBold"/>
<StackPanel DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><TextBox Width="110" Text="{Binding CartQuantity}" AutomationProperties.Name="Nueva cantidad del carrito"/><Button Content="Cambiar cantidad" Command="{Binding EditCartCommand}"/><Button Content="Quitar" Command="{Binding RemoveCartCommand}"/></StackPanel><TextBlock Text="{Binding Total, StringFormat=Total: {0}}" FontSize="28" FontWeight="Bold" Margin="8"/><ComboBox ItemsSource="{Binding Payments}" SelectedItem="{Binding Payment}" DisplayMemberPath="Label" AutomationProperties.Name="Medio de pago"/><Button Content="Confirmar cobro" Command="{Binding CheckoutCommand}"/><TextBlock Text="Agregá productos para empezar una venta." Visibility="{Binding EmptyCartVisibility}" Margin="8"/></StackPanel>
<DataGrid ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCart}"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding QuantityLabel}"/><DataGridTextColumn Header="Importe" Binding="{Binding TotalLabel}"/></DataGrid.Columns></DataGrid></DockPanel>
</Grid></TabItem>
<TabItem Header="Productos"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal"><TextBox Width="260" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar catálogo"/><CheckBox Content="Mostrar inactivos" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" Margin="8"/><Button Content="Nuevo producto" Command="{Binding NewProductCommand}"/><Button Content="Editar" Command="{Binding EditProductCommand}"/><Button Content="Activar / desactivar" Command="{Binding ToggleProductCommand}"/></StackPanel>
<DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Product.Code}"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Product.Category}"/><DataGridTextColumn Header="Unidad" Binding="{Binding UnitLabel}"/><DataGridTextColumn Header="Stock" Binding="{Binding ModeLabel}"/><DataGridTextColumn Header="Precio" Binding="{Binding Price}"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding Product.Active}"/></DataGrid.Columns></DataGrid>
<GroupBox Grid.Row="2" Header="Cambio masivo de precios" Padding="8"><StackPanel><WrapPanel><TextBlock Text="Categoría (vacía = todas)" VerticalAlignment="Center"/><TextBox Width="160" Text="{Binding PriceCategory}"/><TextBlock Text="Cambio (+ / −)" VerticalAlignment="Center"/><TextBox Width="90" Text="{Binding PriceAmount}"/><CheckBox Content="Porcentaje" IsChecked="{Binding IsPercentage}" VerticalAlignment="Center"/><TextBlock Text="Redondear a $" VerticalAlignment="Center" Margin="8,0"/><TextBox Width="80" Text="{Binding PriceRounding}"/><Button Content="Vista previa" Command="{Binding PreviewCommand}"/><Button Content="Aplicar" Command="{Binding ApplyPricesCommand}"/></WrapPanel><TextBlock Text="{Binding PreviewCount}"/><DataGrid ItemsSource="{Binding Preview}" Height="145"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Anterior ($)" Binding="{Binding OldPrice}"/><DataGridTextColumn Header="Nuevo ($)" Binding="{Binding NewPrice}"/></DataGrid.Columns></DataGrid></StackPanel></GroupBox>
</Grid></TabItem>
<TabItem Header="Inventario"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/></Grid.RowDefinitions>
<DataGrid ItemsSource="{Binding Inventory}" SelectedItem="{Binding SelectedInventory}"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Row.Name}" Width="*"/><DataGridTextColumn Header="Existencias" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="1"><WrapPanel><TextBlock Text="Cantidad (kg, unidades o packs)" VerticalAlignment="Center"/><TextBox Width="110" Text="{Binding StockQuantity}"/><TextBlock Text="Motivo" VerticalAlignment="Center"/><TextBox Width="220" Text="{Binding StockNote}"/><Button Content="Reponer" Command="{Binding RestockCommand}"/><Button Content="Establecer stock" Command="{Binding AdjustStockCommand}"/></WrapPanel><WrapPanel><TextBlock Text="Mínimo" VerticalAlignment="Center"/><TextBox Width="100" Text="{Binding MinimumQuantity}"/><Button Content="Guardar mínimo" Command="{Binding MinimumStockCommand}"/><TextBlock Text="Reposición manual" VerticalAlignment="Center"/><ComboBox Width="180" ItemsSource="{Binding Statuses}" SelectedItem="{Binding ManualStatus}"/><Button Content="Guardar estado" Command="{Binding ManualStatusCommand}"/><Button Content="Ver movimientos" Command="{Binding MovementsCommand}"/></WrapPanel></StackPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding Movements}"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}"/><DataGridTextColumn Header="Movimiento" Binding="{Binding Type}"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Motivo" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid>
</Grid></TabItem>
<TabItem Header="Historial"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel><TextBlock Text="Desde" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding From}" Margin="6"/><TextBlock Text="Hasta" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding To}" Margin="6"/><Button Content="Buscar ventas" Command="{Binding HistoryCommand}"/><Button Content="Ver detalle" Command="{Binding SaleDetailsCommand}"/></WrapPanel>
<DataGrid Grid.Row="1" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"><DataGrid.Columns><DataGridTextColumn Header="N.º" Binding="{Binding Sale.Id}"/><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Pago" Binding="{Binding Payment}"/><DataGridTextColumn Header="Total" Binding="{Binding Total}"/></DataGrid.Columns></DataGrid>
<DataGrid Grid.Row="2" ItemsSource="{Binding SaleDetails}"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Precio histórico" Binding="{Binding Price}"/><DataGridTextColumn Header="Importe" Binding="{Binding Total}"/></DataGrid.Columns></DataGrid>
<WrapPanel Grid.Row="3"><TextBlock Text="Motivo de anulación" VerticalAlignment="Center"/><TextBox Width="400" Text="{Binding CancellationReason}"/><Button Content="Anular venta" Command="{Binding CancelSaleCommand}"/></WrapPanel>
</Grid></TabItem>
</TabControl></DockPanel></Window>
