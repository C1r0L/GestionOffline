<ui:FluentWindow x:Class="POS.Desktop.ConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="460" Height="240" MinHeight="0" MinWidth="0" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{StaticResource SurfaceBrush}">
<StackPanel x:Name="Root">
<ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" ShowHelp="False" CanMaximize="False"/>
<DockPanel Margin="24,4,24,20">
<Border x:Name="IconBadge" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Top" Margin="0,0,14,0"><ui:SymbolIcon x:Name="BadgeIcon" Symbol="QuestionCircle24" FontSize="22" Foreground="{StaticResource PrimaryBrush}"/></Border>
<StackPanel><TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock x:Name="Body" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"/></StackPanel>
</DockPanel>
<Border Background="#F8FBFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<ui:Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" MinWidth="110" MinHeight="40" Margin="0,0,8,0" Click="CancelClick"/>
<ui:Button x:Name="ConfirmButton" Content="Confirmar" Appearance="Primary" MinWidth="130" MinHeight="40" Click="ConfirmClick"/>
</StackPanel>
</Border>
</StackPanel>
</ui:FluentWindow>
