<ui:FluentWindow x:Class="POS.Desktop.PrintPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Vista previa del cierre" Width="720" Height="760" MinHeight="0" MinWidth="0" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{StaticResource GroundBrush}">
<DockPanel>
<ui:TitleBar DockPanel.Dock="Top" Title="Vista previa del cierre" ShowMinimize="False" ShowHelp="False"/>
<Border DockPanel.Dock="Bottom" Background="#F8FBFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
<DockPanel>
<TextBlock Text="Para guardar un PDF, elegí «Microsoft Print to PDF» como impresora." Style="{StaticResource Hint}" VerticalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<ui:Button Content="Cerrar" IsCancel="True" MinWidth="110" MinHeight="44" Margin="0,0,8,0"/>
<ui:Button Content="Imprimir…" Icon="{ui:SymbolIcon Print24}" Appearance="Primary" IsDefault="True" MinWidth="140" MinHeight="44" Click="PrintClick"/>
</StackPanel>
</DockPanel>
</Border>
<Border Margin="24,8,24,16" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
<Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.08"/></Border.Effect>
<FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Padding="8"/>
</Border>
</DockPanel>
</ui:FluentWindow>
