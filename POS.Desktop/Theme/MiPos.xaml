<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- Paleta MiPOS: celestes y verdes claros -->
<Color x:Key="GroundColor">#F3F7F9</Color>
<Color x:Key="PrimaryColor">#0B6E8A</Color>
<Color x:Key="AccentColor">#12805C</Color>
<SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}"/>
<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="LineBrush" Color="#DCE6EB"/>
<SolidColorBrush x:Key="InkBrush" Color="#12303B"/>
<SolidColorBrush x:Key="MutedBrush" Color="#4F6872"/>
<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
<SolidColorBrush x:Key="PrimarySoftBrush" Color="#E6F4F8"/>
<SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
<SolidColorBrush x:Key="SuccessSoftBrush" Color="#DDF5EA"/>
<SolidColorBrush x:Key="SuccessInkBrush" Color="#0D6B4C"/>
<SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF1D6"/>
<SolidColorBrush x:Key="WarningInkBrush" Color="#8A5300"/>
<SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE2E1"/>
<SolidColorBrush x:Key="DangerInkBrush" Color="#A3261F"/>
<LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0.45,1"><GradientStop Color="#CDEEF8" Offset="0"/><GradientStop Color="#D8F3EA" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="StrongGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/><GradientStop Color="{StaticResource AccentColor}" Offset="1"/></LinearGradientBrush>

<Style x:Key="Card" TargetType="Border">
<Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
<Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="CornerRadius" Value="12"/>
<Setter Property="Padding" Value="16"/>
</Style>
<Style x:Key="PageTitle" TargetType="TextBlock">
<Setter Property="FontSize" Value="26"/>
<Setter Property="FontWeight" Value="Bold"/>
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style x:Key="SectionTitle" TargetType="TextBlock">
<Setter Property="FontSize" Value="18"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style x:Key="FieldLabel" TargetType="TextBlock">
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="Margin" Value="0,0,0,6"/>
</Style>
<Style x:Key="Hint" TargetType="TextBlock">
<Setter Property="FontSize" Value="13"/>
<Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
<Setter Property="TextWrapping" Value="Wrap"/>
</Style>

<!-- Menú lateral -->
<Style x:Key="NavList" TargetType="ListBox">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><StackPanel IsItemsHost="True"/></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="NavItem" TargetType="ListBoxItem">
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="FontSize" Value="14"/>
<Setter Property="Margin" Value="0,0,0,4"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
<Border x:Name="Bd" MinHeight="44" Padding="12,0" CornerRadius="8" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
<ContentPresenter VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#80FFFFFF"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
<Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<!-- Chips de selección (categorías, medio de pago): ListBox con SelectedItem -->
<Style x:Key="ChipList" TargetType="ListBox">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter>
<Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="Chip" TargetType="ListBoxItem">
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="Margin" Value="0,0,8,8"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
<Border x:Name="Bd" MinHeight="36" Padding="14,0" CornerRadius="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
<ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
<Setter Property="Foreground" Value="White"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="PaymentChip" TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
<Setter Property="Margin" Value="0,0,6,0"/>
<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
<Border x:Name="Bd" MinHeight="44" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
<ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBrush}"/></Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
<Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
<Setter Property="FontWeight" Value="Bold"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>

<!-- Tarjeta de producto en Nueva venta -->
<Style x:Key="ProductTile" TargetType="Button">
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="Height" Value="124"/>
<Setter Property="Margin" Value="0,0,12,12"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border x:Name="Bd" CornerRadius="12" Padding="14,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
<ContentPresenter/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Bd" Property="Background" Value="#FBFEFF"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<!-- Etiqueta de stock: Tag = ok | low | out | none -->
<Style x:Key="StockPill" TargetType="Border">
<Setter Property="CornerRadius" Value="9"/>
<Setter Property="Padding" Value="8,1"/>
<Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
<Setter Property="TextElement.Foreground" Value="{StaticResource SuccessInkBrush}"/>
<Setter Property="TextElement.FontSize" Value="11"/>
<Setter Property="TextElement.FontWeight" Value="SemiBold"/>
<Style.Triggers>
<Trigger Property="Tag" Value="low"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarningInkBrush}"/></Trigger>
<Trigger Property="Tag" Value="out"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerInkBrush}"/></Trigger>
<Trigger Property="Tag" Value="none"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
</Style.Triggers>
</Style>

<!-- Líneas del carrito -->
<Style x:Key="CartList" TargetType="ListBox">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" Padding="0"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="CartLine" TargetType="ListBoxItem">
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
<Grid>
<Border x:Name="Bd" Padding="18,12" Background="Transparent" BorderBrush="#E7EEF1" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
<Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Background="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
</Grid>
<ControlTemplate.Triggers>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EEF8FB"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="StepButton" TargetType="Button">
<Setter Property="Width" Value="40"/>
<Setter Property="Height" Value="36"/>
<Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
<Setter Property="FontSize" Value="18"/>
<Setter Property="FontWeight" Value="Bold"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border x:Name="Bd" Background="{StaticResource GroundBrush}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="QuietButton" TargetType="Button">
<Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
<Setter Property="MinWidth" Value="36"/>
<Setter Property="MinHeight" Value="36"/>
<Setter Property="Padding" Value="8,0"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource GroundBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<!-- Error de validación debajo de un campo; se oculta cuando no hay texto -->
<Style x:Key="FieldError" TargetType="TextBlock">
<Setter Property="Foreground" Value="{StaticResource DangerInkBrush}"/>
<Setter Property="FontSize" Value="12.5"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="TextWrapping" Value="Wrap"/>
<Setter Property="Margin" Value="0,4,0,0"/>
<Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
</Style>

<!-- Opciones en tarjetas (unidad de venta, control de stock): ítems con Title, Detail y Enabled -->
<Style x:Key="OptionList" TargetType="ListBox">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter>
<Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter>
<Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
<StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel>
</DataTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="OptionCard" TargetType="ListBoxItem">
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="Margin" Value="0,0,8,0"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="IsEnabled" Value="{Binding Enabled}"/>
<Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
<Border x:Name="Bd" MinHeight="62" Padding="12,8" CornerRadius="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
<ContentPresenter VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBrush}"/></Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
<Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
</Trigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Bd" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></MultiTrigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>

<!-- Etiqueta neutra (categoría) y de estado activo/inactivo; Tag = Activo | Inactivo -->
<Style x:Key="TagPill" TargetType="Border">
<Setter Property="CornerRadius" Value="11"/>
<Setter Property="Padding" Value="10,2"/>
<Setter Property="HorizontalAlignment" Value="Left"/>
<Setter Property="Background" Value="#EEF3F5"/>
<Setter Property="TextElement.FontSize" Value="12"/>
<Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style x:Key="StatePill" TargetType="Border" BasedOn="{StaticResource TagPill}">
<Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
<Setter Property="TextElement.Foreground" Value="{StaticResource SuccessInkBrush}"/>
<Setter Property="TextElement.FontWeight" Value="SemiBold"/>
<Style.Triggers><Trigger Property="Tag" Value="Inactivo"><Setter Property="Background" Value="#EEF3F5"/><Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}"/></Trigger></Style.Triggers>
</Style>
<!-- Selector segmentado (RadioButton) -->
<Style x:Key="Segment" TargetType="RadioButton">
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="MinHeight" Value="42"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
<Border x:Name="Bd" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MinHeight="{TemplateBinding MinHeight}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBrush}"/></Trigger>
<Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="ShortcutHint" TargetType="TextBlock">
<Setter Property="FontSize" Value="12"/>
<Setter Property="FontWeight" Value="Normal"/>
<Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
<Setter Property="VerticalAlignment" Value="Center"/>
</Style>
</ResourceDictionary>
