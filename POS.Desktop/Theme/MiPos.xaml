<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- Paleta MiPOS: celestes y verdes claros -->
<Color x:Key="GroundColor">#F3F7F9</Color>
<Color x:Key="PrimaryColor">#0B6E8A</Color>
<Color x:Key="AccentColor">#12805C</Color>
<SolidColorBrush x:Key="GroundBrush" Color="{StaticResource GroundColor}"/>
<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="LineBrush" Color="#DCE6EB"/>
<SolidColorBrush x:Key="InkBrush" Color="#12303B"/>
<SolidColorBrush x:Key="MutedBrush" Color="#4F6872"/>
<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
<SolidColorBrush x:Key="PrimarySoftBrush" Color="#E6F4F8"/>
<SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
<SolidColorBrush x:Key="SuccessSoftBrush" Color="#DDF5EA"/>
<SolidColorBrush x:Key="SuccessInkBrush" Color="#0D6B4C"/>
<SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF1D6"/>
<SolidColorBrush x:Key="WarningInkBrush" Color="#8A5300"/>
<SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE2E1"/>
<SolidColorBrush x:Key="DangerInkBrush" Color="#A3261F"/>
<LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0.45,1"><GradientStop Color="#CDEEF8" Offset="0"/><GradientStop Color="#D8F3EA" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="StrongGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/><GradientStop Color="{StaticResource AccentColor}" Offset="1"/></LinearGradientBrush>

<Style x:Key="Card" TargetType="Border">
<Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
<Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="CornerRadius" Value="12"/>
<Setter Property="Padding" Value="16"/>
</Style>
<Style x:Key="PageTitle" TargetType="TextBlock">
<Setter Property="FontSize" Value="26"/>
<Setter Property="FontWeight" Value="Bold"/>
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style x:Key="SectionTitle" TargetType="TextBlock">
<Setter Property="FontSize" Value="18"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
</Style>
<Style x:Key="FieldLabel" TargetType="TextBlock">
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="Margin" Value="0,0,0,6"/>
</Style>
<Style x:Key="Hint" TargetType="TextBlock">
<Setter Property="FontSize" Value="13"/>
<Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
<Setter Property="TextWrapping" Value="Wrap"/>
</Style>

<!-- Menú lateral -->
<Style x:Key="NavList" TargetType="ListBox">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><StackPanel IsItemsHost="True"/></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="NavItem" TargetType="ListBoxItem">
<Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
<Setter Property="FontSize" Value="14"/>
<Setter Property="Margin" Value="0,0,0,4"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
<Border x:Name="Bd" MinHeight="44" Padding="12,0" CornerRadius="8" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
<ContentPresenter VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#80FFFFFF"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
<Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="ShortcutHint" TargetType="TextBlock">
<Setter Property="FontSize" Value="12"/>
<Setter Property="FontWeight" Value="Normal"/>
<Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
<Setter Property="VerticalAlignment" Value="Center"/>
</Style>
</ResourceDictionary>
