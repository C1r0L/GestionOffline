<ui:FluentWindow x:Class="POS.Desktop.ProductWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Producto" Width="560" Height="712" MinHeight="0" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{StaticResource SurfaceBrush}">
<DockPanel><ui:TitleBar DockPanel.Dock="Top" ShowMinimize="False" ShowMaximize="False" ShowHelp="False" CanMaximize="False"/>
<ScrollViewer><StackPanel Margin="26,0,26,22"><TextBlock Text="Datos del producto" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,0,0,4"/><TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><ui:TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Código (opcional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><ui:TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><ui:TextBox Text="{Binding Category,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Unidad de venta" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><ComboBox ItemsSource="{Binding Units}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Unit}" IsEnabled="{Binding IsNew}"/><TextBlock Text="Control de stock" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><ComboBox ItemsSource="{Binding Modes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Mode}" IsEnabled="{Binding IsNew}"/><TextBlock Text="Precio en pesos por kg, unidad o pack seleccionado" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" TextWrapping="Wrap"/><ui:TextBox Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Costo en pesos (opcional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><ui:TextBox Text="{Binding Cost,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Producto activo" IsChecked="{Binding Active}" Margin="0,14,0,0"/><TextBlock Text="Un pack se vende y controla como un pack completo. Por kg, ingresá cantidades con precisión de un gramo." TextWrapping="Wrap" Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerInkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><ui:Button Content="Cancelar" IsCancel="True" MinWidth="110" MinHeight="40" Margin="0,0,8,0"/><ui:Button Content="Guardar" Appearance="Primary" IsDefault="True" Click="SaveClick" MinWidth="130" MinHeight="40"/></StackPanel></StackPanel></ScrollViewer></DockPanel>
</ui:FluentWindow>
