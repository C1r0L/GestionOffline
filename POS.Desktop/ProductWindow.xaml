<ui:FluentWindow x:Class="POS.Desktop.ProductWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}" Width="600" Height="760" MinHeight="0" MinWidth="0" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{StaticResource SurfaceBrush}">
<StackPanel x:Name="Root">
<Border Background="{StaticResource SidebarGradient}">
<StackPanel>
<ui:TitleBar ShowMinimize="False" ShowMaximize="False" ShowHelp="False" CanMaximize="False"/>
<TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="22" Margin="24,0,24,16"/>
</StackPanel>
</Border>

<StackPanel Margin="24,18,24,8">
<TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
<ui:TextBox x:Name="NameBox" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ej.: Fideos tirabuzón 500 g" AutomationProperties.Name="Nombre"/>
<TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}"/>

<Grid Margin="0,10,0,0">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Código (opcional)" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Escaneá o escribí" AutomationProperties.Name="Código"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Categoría" Style="{StaticResource FieldLabel}"/><ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding Category,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Categoría"/></StackPanel>
</Grid>

<TextBlock Text="¿Cómo se vende?" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
<ListBox Style="{StaticResource OptionList}" ItemContainerStyle="{StaticResource OptionCard}" ItemsSource="{Binding Units}" SelectedValuePath="Value" SelectedValue="{Binding Unit}" AutomationProperties.Name="Unidad de venta"/>

<TextBlock Text="Control de stock" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
<ListBox Style="{StaticResource OptionList}" ItemContainerStyle="{StaticResource OptionCard}" ItemsSource="{Binding Modes}" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.Name="Control de stock"/>
<TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="La unidad y el control de stock no se pueden cambiar después de crear el producto. Si cambia la presentación, desactivalo y creá otro."/>

<Grid Margin="0,16,0,0">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{Binding PriceLabel}" Style="{StaticResource FieldLabel}"/>
<DockPanel><TextBlock Text="$" DockPanel.Dock="Left" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/><ui:TextBox Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0,00" AutomationProperties.Name="Precio"/></DockPanel>
<TextBlock Text="{Binding PriceError}" Style="{StaticResource FieldError}"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Costo (opcional)" Style="{StaticResource FieldLabel}"/>
<DockPanel><TextBlock Text="$" DockPanel.Dock="Left" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/><ui:TextBox Text="{Binding Cost,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0,00" AutomationProperties.Name="Costo"/></DockPanel>
<TextBlock Text="{Binding CostError}" Style="{StaticResource FieldError}"/></StackPanel>
<Border Grid.Column="4" VerticalAlignment="Top" Margin="0,25,0,0" MinHeight="38" MinWidth="120" Padding="12,0" CornerRadius="8" Background="{StaticResource SuccessSoftBrush}" ToolTip="Ganancia sobre el costo">
<TextBlock Text="{Binding MarginLabel}" FontWeight="Bold" Foreground="{StaticResource SuccessInkBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
</Border>
</Grid>
<TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,6,0,0"/>
</StackPanel>

<Border Background="#F8FBFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
<DockPanel>
<CheckBox Content="Producto activo" IsChecked="{Binding Active}" VerticalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<ui:Button Content="Cancelar" IsCancel="True" MinWidth="110" MinHeight="44" Margin="0,0,8,0"/>
<ui:Button Content="Guardar producto" Appearance="Primary" IsDefault="True" Click="SaveClick" MinWidth="150" MinHeight="44"/>
</StackPanel>
</DockPanel>
</Border>
</StackPanel>
</ui:FluentWindow>
