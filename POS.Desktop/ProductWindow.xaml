<Window x:Class="POS.Desktop.ProductWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Producto" Width="520" Height="730" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
<ScrollViewer><StackPanel Margin="22"><TextBlock Text="Datos del producto" FontSize="24" FontWeight="Bold"/><TextBlock Text="Nombre"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Código (opcional)"/><TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Categoría"/><TextBox Text="{Binding Category,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Unidad de venta"/><ComboBox ItemsSource="{Binding Units}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Unit}" IsEnabled="{Binding IsNew}"/><TextBlock Text="Control de stock"/><ComboBox ItemsSource="{Binding Modes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Mode}" IsEnabled="{Binding IsNew}"/><TextBlock Text="Precio en pesos por kg, unidad o pack seleccionado" TextWrapping="Wrap"/><TextBox Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Costo en pesos (opcional)"/><TextBox Text="{Binding Cost,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Producto activo" IsChecked="{Binding Active}" Margin="8"/><TextBlock Text="Un pack se vende y controla como un pack completo. Por kg, ingresá cantidades con precisión de un gramo." TextWrapping="Wrap" Margin="4"/><TextBlock Text="{Binding Error}" Foreground="#A72020" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True"/><Button Content="Guardar" IsDefault="True" Click="SaveClick"/></StackPanel></StackPanel></ScrollViewer>
</Window>
