<Application x:Class="POS.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="16"/><Setter Property="Background" Value="#F2F5F9"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="42"/><Setter Property="Background" Value="#E1EAF8"/><Setter Property="Foreground" Value="#17365D"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="38"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="38"/></Style>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="42"/><Setter Property="Margin" Value="4"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="18,12"/></Style>
</Application.Resources></Application>
