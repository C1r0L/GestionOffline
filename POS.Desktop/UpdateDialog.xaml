<ui:FluentWindow x:Class="POS.Desktop.UpdateDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Actualización disponible" Width="520" Height="560" MinHeight="0" MinWidth="0" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{StaticResource SurfaceBrush}" PreviewKeyDown="DialogKeyDown" Closing="DialogClosing">
<StackPanel x:Name="Root">
<Border Background="{StaticResource StrongGradient}">
<StackPanel>
<ui:TitleBar ShowMinimize="False" ShowMaximize="False" ShowHelp="False" CanMaximize="False" ButtonsForeground="White"/>
<StackPanel Margin="24,0,24,18">
<TextBlock Text="Hay una versión nueva de MiPOS" Foreground="White" FontSize="14"/>
<TextBlock x:Name="NewVersion" Foreground="White" FontSize="30" FontWeight="Bold"/>
<TextBlock x:Name="CurrentVersion" Foreground="White" Opacity="0.9" FontSize="13"/>
</StackPanel>
</StackPanel>
</Border>
<StackPanel Margin="24,16,24,14">
<TextBlock Text="Novedades" Style="{StaticResource FieldLabel}"/>
<Border Background="{StaticResource GroundBrush}" CornerRadius="8" Padding="12,10" MaxHeight="170">
<ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Notes" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource InkBrush}"/></ScrollViewer>
</Border>
<TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Antes de instalar se hace un respaldo de tus datos. MiPOS se cierra, se actualiza y se vuelve a abrir sola; tus productos, stock y ventas se conservan."/>
<Border x:Name="CartWarning" Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
<TextBlock Text="Hay una venta en curso. Cobrala o vaciá el carrito antes de actualizar." TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource WarningInkBrush}"/>
</Border>
<StackPanel x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Hidden">
<DockPanel><TextBlock x:Name="ProgressText" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Descargando y verificando…" FontSize="13" FontWeight="SemiBold"/></DockPanel>
<ProgressBar x:Name="Progress" Height="8" Margin="0,6,0,0" Minimum="0" Maximum="1"/>
</StackPanel>
<TextBlock x:Name="Error" Style="{StaticResource FieldError}" Margin="0,8,0,0"/>
</StackPanel>
<Border Background="#F8FBFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<ui:Button x:Name="LaterButton" Content="Más tarde" MinWidth="110" MinHeight="44" Margin="0,0,8,0" Click="LaterClick"/>
<ui:Button x:Name="InstallButton" Content="Descargar e instalar" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" IsDefault="True" MinWidth="170" MinHeight="44" Click="InstallClick"/>
</StackPanel>
</Border>
</StackPanel>
</ui:FluentWindow>
