<UserControl x:Class="POS.Desktop.Views.ProductsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="Page">
<UserControl.InputBindings><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProductCommand}"/></UserControl.InputBindings>
<DockPanel Margin="26,16,26,22">
<DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
<ui:Button Content="Ajustar precios" Icon="{ui:SymbolIcon ArrowTrending24}" Command="{Binding TogglePricePanelCommand}" MinHeight="40" Margin="0,0,8,0"/>
<ui:Button Content="Nuevo producto" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding NewProductCommand}" MinHeight="40" ToolTip="Ctrl+N"/>
</StackPanel>
<StackPanel><TextBlock Text="Productos" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding ProductCountLabel}" Style="{StaticResource Hint}"/></StackPanel>
</DockPanel>

<DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
<CheckBox DockPanel.Dock="Right" Content="Mostrar inactivos" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" Margin="12,0,0,0"/>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
<TextBlock Text="Categoría" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
<ComboBox Width="150" ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding ProductCategory}" AutomationProperties.Name="Filtrar por categoría"/>
</StackPanel>
<ui:TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Buscar por nombre o código" MinWidth="160" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Buscar en el catálogo"/>
</DockPanel>

<TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Doble clic o Enter sobre una fila para editar. Ctrl+N crea un producto."/>

<Grid>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
<DockPanel>
<Grid DockPanel.Dock="Top" Margin="12,10,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*" MinWidth="140"/><ColumnDefinition Width="1*" MinWidth="95"/><ColumnDefinition Width="1.3*" MinWidth="120"/><ColumnDefinition Width="1*" MinWidth="95"/><ColumnDefinition Width="0.7*" MinWidth="60"/><ColumnDefinition Width="0.8*" MinWidth="76"/><ColumnDefinition Width="1*" MinWidth="110"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="PRODUCTO" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="2" Text="SE VENDE POR" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="3" Text="PRECIO" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" Margin="0,0,8,0"/><TextBlock Grid.Column="4" Text="MARGEN" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" Margin="0,0,8,0"/><TextBlock Grid.Column="5" Text="ESTADO" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="6" Text="" Style="{StaticResource TableHeader}"/></Grid>
<ListBox x:Name="Grid" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" MouseDoubleClick="GridDoubleClick" PreviewKeyDown="GridKeyDown" AutomationProperties.Name="Catálogo de productos">
<ListBox.ItemTemplate><DataTemplate>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*" MinWidth="140"/><ColumnDefinition Width="1*" MinWidth="95"/><ColumnDefinition Width="1.3*" MinWidth="120"/><ColumnDefinition Width="1*" MinWidth="95"/><ColumnDefinition Width="0.7*" MinWidth="60"/><ColumnDefinition Width="0.8*" MinWidth="76"/><ColumnDefinition Width="1*" MinWidth="110"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Code}" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel>
<Border Grid.Column="1" Style="{StaticResource TagPill}" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis"/></Border>
<TextBlock Grid.Column="2" Text="{Binding SellLabel}" VerticalAlignment="Center" Foreground="#3E5A64" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
<TextBlock Grid.Column="3" Text="{Binding Price}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,0,8,0"/>
<TextBlock Grid.Column="4" Text="{Binding Margin}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#3E5A64" Margin="0,0,8,0" ToolTip="Ganancia sobre el costo"/>
<Border Grid.Column="5" Style="{StaticResource StatePill}" Tag="{Binding StateLabel}" VerticalAlignment="Center"><TextBlock Text="{Binding StateLabel}"/></Border>
<StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
<Button Style="{StaticResource QuietButton}" Command="{Binding DataContext.EditProductCommand,ElementName=Page}" CommandParameter="{Binding}" AutomationProperties.Name="Editar producto" ToolTip="Editar"><ui:SymbolIcon Symbol="Edit24" FontSize="18" Foreground="{StaticResource PrimaryBrush}"/></Button>
<Button Style="{StaticResource QuietButton}" Command="{Binding DataContext.ToggleProductCommand,ElementName=Page}" CommandParameter="{Binding}" Content="{Binding ToggleLabel}" FontSize="12"/>
</StackPanel>
</Grid>
</DataTemplate></ListBox.ItemTemplate>
</ListBox>
</DockPanel>
</Border>

<!-- Ajuste masivo de precios: cajón superpuesto sobre la tabla -->
<Border Width="360" Margin="0,10,10,10" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding PricePanelVisibility}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14">
<Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.10" Color="#12303B"/></Border.Effect>
<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
<StackPanel>
<DockPanel Margin="0,0,0,12">
<Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Command="{Binding TogglePricePanelCommand}" AutomationProperties.Name="Cerrar panel"><ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/></Button>
<TextBlock Text="Ajustar precios" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
</DockPanel>
<TextBlock Text="Categoría" Style="{StaticResource FieldLabel}"/>
<ComboBox ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding PriceCategory}" AutomationProperties.Name="Categoría a ajustar"/>
<TextBlock Text="Tipo de cambio" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
<UniformGrid Rows="1">
<RadioButton Style="{StaticResource Segment}" Content="Porcentaje %" IsChecked="{Binding IsPercentage}" Margin="0,0,4,0" GroupName="PriceKind"/>
<RadioButton Style="{StaticResource Segment}" Content="Monto fijo $" IsChecked="{Binding IsFixedAmount}" Margin="4,0,0,0" GroupName="PriceKind"/>
</UniformGrid>
<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Cambio (+ / −)" Style="{StaticResource FieldLabel}"/>
<DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AmountSuffix}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/><ui:TextBox Text="{Binding PriceAmount,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cambio de precio"/></DockPanel></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Redondear a" Style="{StaticResource FieldLabel}"/>
<ComboBox ItemsSource="{Binding Roundings}" SelectedItem="{Binding PriceRounding}" DisplayMemberPath="Label" AutomationProperties.Name="Redondear a"/></StackPanel>
</Grid>
<TextBlock Text="{Binding PreviewError}" Style="{StaticResource FieldError}"/>
<Border BorderBrush="#E7EEF1" BorderThickness="1" CornerRadius="10" Margin="0,14,0,0">
<StackPanel>
<Border Background="{StaticResource GroundBrush}" CornerRadius="10,10,0,0" Padding="12,8"><TextBlock Text="{Binding PreviewCount}" FontSize="12" FontWeight="SemiBold" Foreground="#3E5A64"/></Border>
<ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
<ItemsControl ItemsSource="{Binding Preview}">
<ItemsControl.ItemTemplate><DataTemplate>
<Border BorderBrush="#EEF3F5" BorderThickness="0,1,0,0" Padding="12,8">
<DockPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
<TextBlock Text="{Binding OldPrice}" Foreground="{StaticResource MutedBrush}" TextDecorations="Strikethrough" FontSize="13"/>
<ui:SymbolIcon Symbol="ArrowRight16" FontSize="12" Margin="6,0" VerticalAlignment="Center"/>
<TextBlock Text="{Binding NewPrice}" Foreground="{StaticResource SuccessInkBrush}" FontWeight="Bold" FontSize="13"/>
</StackPanel>
<TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
</DockPanel>
</Border>
</DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</ScrollViewer>
</StackPanel>
</Border>
<ui:Button Content="{Binding ApplyLabel}" Appearance="Primary" Command="{Binding ApplyPricesCommand}" HorizontalAlignment="Stretch" MinHeight="46" FontWeight="Bold" Margin="0,14,0,0"/>
<TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="La vista previa se recalcula sola. Solo se ajustan productos activos."/>
</StackPanel>
</ScrollViewer>
</Border>
</Grid>
</DockPanel>
</UserControl>
