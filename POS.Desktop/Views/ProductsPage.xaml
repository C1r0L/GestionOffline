<UserControl x:Class="POS.Desktop.Views.ProductsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
<Grid Margin="26,16,26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Productos" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><ui:TextBox Width="300" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Buscar por nombre, código o categoría" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Buscar catálogo"/><CheckBox Content="Mostrar inactivos" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" Margin="12,0"/><ui:Button Content="Nuevo producto" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewProductCommand}" Margin="0,0,8,0"/><ui:Button Content="Editar" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditProductCommand}" Margin="0,0,8,0"/><ui:Button Content="Activar / desactivar" Command="{Binding ToggleProductCommand}"/></WrapPanel>
<ui:DataGrid Grid.Row="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Product.Code}"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Product.Category}"/><DataGridTextColumn Header="Unidad" Binding="{Binding UnitLabel}"/><DataGridTextColumn Header="Stock" Binding="{Binding ModeLabel}"/><DataGridTextColumn Header="Precio" Binding="{Binding Price}"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding Product.Active}"/></DataGrid.Columns></ui:DataGrid>
<Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Cambio masivo de precios" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><WrapPanel><TextBlock Text="Categoría (vacía = todas)" VerticalAlignment="Center" Margin="0,0,8,0"/><ui:TextBox Width="160" Text="{Binding PriceCategory}"/><TextBlock Text="Cambio (+ / −)" VerticalAlignment="Center" Margin="12,0,8,0"/><ui:TextBox Width="90" Text="{Binding PriceAmount}"/><CheckBox Content="Porcentaje" IsChecked="{Binding IsPercentage}" VerticalAlignment="Center" Margin="12,0"/><TextBlock Text="Redondear a $" VerticalAlignment="Center" Margin="0,0,8,0"/><ui:TextBox Width="80" Text="{Binding PriceRounding}"/><ui:Button Content="Vista previa" Command="{Binding PreviewCommand}" Margin="12,0,8,0"/><ui:Button Content="Aplicar" Appearance="Primary" Command="{Binding ApplyPricesCommand}"/></WrapPanel><TextBlock Text="{Binding PreviewCount}" Style="{StaticResource Hint}" Margin="0,8"/><ui:DataGrid ItemsSource="{Binding Preview}" Height="130" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Anterior" Binding="{Binding OldPrice}"/><DataGridTextColumn Header="Nuevo" Binding="{Binding NewPrice}"/></DataGrid.Columns></ui:DataGrid></StackPanel></Border>
</Grid>
</UserControl>
