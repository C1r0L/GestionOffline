<UserControl x:Class="POS.Desktop.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
<Grid Margin="26,16,26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Historial de ventas" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker SelectedDate="{Binding From}"/><TextBlock Text="Hasta" VerticalAlignment="Center" Margin="12,0,8,0"/><DatePicker SelectedDate="{Binding To}"/><ui:Button Content="Buscar ventas" Appearance="Primary" Command="{Binding HistoryCommand}" Margin="12,0,8,0"/><ui:Button Content="Ver detalle" Command="{Binding SaleDetailsCommand}"/></WrapPanel>
<ui:DataGrid Grid.Row="2" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="N.º" Binding="{Binding Sale.Id}"/><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" MinWidth="130"/><DataGridTextColumn Header="Pago" Binding="{Binding Payment}" MinWidth="140"/><DataGridTextColumn Header="Total" Binding="{Binding Total}"/></DataGrid.Columns></ui:DataGrid>
<ui:DataGrid Grid.Row="3" Margin="0,12,0,0" ItemsSource="{Binding SaleDetails}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Precio histórico" Binding="{Binding Price}"/><DataGridTextColumn Header="Importe" Binding="{Binding Total}"/></DataGrid.Columns></ui:DataGrid>
<WrapPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="Motivo de anulación" VerticalAlignment="Center" Margin="0,0,8,0"/><ui:TextBox Width="400" Text="{Binding CancellationReason}"/><ui:Button Content="Anular venta" Appearance="Danger" Command="{Binding CancelSaleCommand}" Margin="8,0,0,0"/></WrapPanel>
</Grid>
</UserControl>
