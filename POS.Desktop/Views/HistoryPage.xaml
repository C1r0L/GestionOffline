<UserControl x:Class="POS.Desktop.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
<DockPanel Margin="26,16,26,22">
<DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
<ListBox DockPanel.Dock="Right" Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding HistoryRanges}" SelectedItem="{Binding HistoryRange}" VerticalAlignment="Center" Margin="0,0,0,-8" AutomationProperties.Name="Período"/>
<StackPanel><TextBlock Text="Historial de ventas" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Hint}"/></StackPanel>
</DockPanel>

<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Visibility="{Binding CustomRangeVisibility}" Margin="0,0,0,12">
<TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker SelectedDate="{Binding From}" AutomationProperties.Name="Desde"/>
<TextBlock Text="Hasta" VerticalAlignment="Center" Margin="14,0,8,0"/><DatePicker SelectedDate="{Binding To}" AutomationProperties.Name="Hasta"/>
</StackPanel>

<UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,14">
<Border Background="{StaticResource StrongGradient}" CornerRadius="12" Padding="16,12" Margin="0,0,6,0">
<StackPanel><TextBlock Text="Total vendido" FontSize="13" Foreground="White"/><TextBlock Text="{Binding TotalSold}" FontSize="28" FontWeight="Bold" Foreground="White"/></StackPanel>
</Border>
<Border Style="{StaticResource StatCard}" Margin="6,0">
<StackPanel><TextBlock Text="Ventas completadas" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CompletedCount}" FontSize="28" FontWeight="Bold"/></StackPanel>
</Border>
<Border Style="{StaticResource StatCard}" Margin="6,0,0,0">
<StackPanel><TextBlock Text="Anuladas" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
<TextBlock><Run Text="{Binding CancelledCount,Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerInkBrush}"/><Run Text="  "/><Run Text="{Binding CancelledTotal,Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerInkBrush}"/></TextBlock></StackPanel>
</Border>
</UniformGrid>

<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>

<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
<Grid>
<ui:DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" RowHeight="48" GridLinesVisibility="None" AutomationProperties.Name="Ventas">
<DataGrid.Columns>
<DataGridTemplateColumn Header="N.º" MinWidth="56" SortMemberPath="Sale.Id"><DataGridTemplateColumn.CellTemplate><DataTemplate>
<TextBlock Text="{Binding Sale.Id}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
</DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="FECHA" Width="*" SortMemberPath="Sale.CreatedAt"><DataGridTemplateColumn.CellTemplate><DataTemplate>
<TextBlock Text="{Binding Date}" VerticalAlignment="Center" Foreground="#3E5A64"/>
</DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="MEDIO DE PAGO" MinWidth="120" SortMemberPath="Payment"><DataGridTemplateColumn.CellTemplate><DataTemplate>
<TextBlock Text="{Binding Payment}" VerticalAlignment="Center"/>
</DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="ESTADO" MinWidth="110" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate>
<Border Style="{StaticResource StockPill}" Tag="{Binding StatusKind}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,2"><TextBlock Text="{Binding Status}" FontSize="12"/></Border>
</DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="TOTAL" MinWidth="110" SortMemberPath="Sale.TotalMinor"><DataGridTemplateColumn.CellTemplate><DataTemplate>
<TextBlock x:Name="Amount" Text="{Binding Total}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,0,8,0"/>
<DataTemplate.Triggers><DataTrigger Binding="{Binding IsCancelled}" Value="True"><Setter TargetName="Amount" Property="TextDecorations" Value="Strikethrough"/><Setter TargetName="Amount" Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter TargetName="Amount" Property="FontWeight" Value="Normal"/></DataTrigger></DataTemplate.Triggers>
</DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns>
</ui:DataGrid>
<StackPanel Visibility="{Binding NoSalesVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center">
<ui:SymbolIcon Symbol="Receipt24" FontSize="40" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
<TextBlock Text="No hay ventas en este período." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
</StackPanel>
</Grid>
</Border>

<!-- Detalle de la venta -->
<Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14">
<Grid>
<StackPanel Visibility="{Binding NoSaleDetailVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
<Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource SidebarGradient}" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Receipt24" FontSize="28" Foreground="{StaticResource PrimaryBrush}"/></Border>
<TextBlock Text="Elegí una venta" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
<TextBlock Text="Vas a ver sus productos con los precios de ese momento." Style="{StaticResource Hint}" TextAlignment="Center"/>
</StackPanel>
<DockPanel Visibility="{Binding SaleDetailVisibility}" Margin="18,16">
<DockPanel DockPanel.Dock="Top">
<Border DockPanel.Dock="Right" Style="{StaticResource StockPill}" Tag="{Binding SelectedSale.StatusKind}" VerticalAlignment="Top" Padding="10,2"><TextBlock Text="{Binding SelectedSale.Status}" FontSize="12"/></Border>
<StackPanel>
<TextBlock Style="{StaticResource SectionTitle}" FontSize="20"><Run Text="Venta n.º "/><Run Text="{Binding SelectedSale.Sale.Id,Mode=OneWay}"/></TextBlock>
<TextBlock Style="{StaticResource Hint}"><Run Text="{Binding SelectedSale.Date,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedSale.Payment,Mode=OneWay}"/></TextBlock>
</StackPanel>
</DockPanel>

<!-- Anulación -->
<Border DockPanel.Dock="Bottom" Visibility="{Binding CancelVisibility}" BorderBrush="#F3C7C4" Background="#FFF7F6" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
<StackPanel>
<TextBlock Text="Motivo de anulación" Style="{StaticResource FieldLabel}"/>
<ui:TextBox Text="{Binding CancellationReason,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ej.: error al cobrar" AutomationProperties.Name="Motivo de anulación"/>
<ui:Button Content="Anular venta…" Appearance="Danger" Command="{Binding CancelSaleCommand}" HorizontalAlignment="Stretch" MinHeight="42" Margin="0,10,0,0"/>
<TextBlock Text="El stock vuelve al inventario. La venta queda registrada como anulada." Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0"/>
</StackPanel>
</Border>
<Border DockPanel.Dock="Bottom" Visibility="{Binding CancelledNoticeVisibility}" Background="{StaticResource DangerSoftBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
<TextBlock Text="Esta venta está anulada: su stock ya volvió al inventario y no suma en los totales." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DangerInkBrush}"/>
</Border>

<DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
<TextBlock Text="Total" FontSize="18" FontWeight="Bold"/>
<TextBlock Text="{Binding SelectedSale.Total}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
</DockPanel>

<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Focusable="False">
<ItemsControl ItemsSource="{Binding SaleDetails}">
<ItemsControl.ItemTemplate><DataTemplate>
<Border BorderBrush="#EEF3F5" BorderThickness="0,0,0,1" Padding="0,9">
<DockPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold" Margin="8,0,0,0"/>
<StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel>
</DockPanel>
</Border>
</DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</ScrollViewer>
</DockPanel>
</Grid>
</Border>
</Grid>
</DockPanel>
</UserControl>
