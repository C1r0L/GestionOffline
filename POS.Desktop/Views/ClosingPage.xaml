<UserControl x:Class="POS.Desktop.Views.ClosingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
<DockPanel Margin="26,16,26,22">
<DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource QuietButton}" Command="{Binding PreviousDayCommand}" AutomationProperties.Name="Día anterior" ToolTip="Día anterior"><ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/></Button>
<TextBlock Text="{Binding ClosingDayLabel}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" MinWidth="170" TextAlignment="Center"/>
<Button Style="{StaticResource QuietButton}" Command="{Binding NextDayCommand}" IsEnabled="{Binding IsClosingToday,Converter={StaticResource Invert}}" AutomationProperties.Name="Día siguiente" ToolTip="Día siguiente"><ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/></Button>
</StackPanel>
</Border>
<ui:Button Content="Hoy" Command="{Binding ClosingTodayCommand}" MinHeight="40" Margin="0,0,8,0" IsEnabled="{Binding IsClosingToday,Converter={StaticResource Invert}}"/>
<ui:Button Content="Imprimir resumen" Icon="{ui:SymbolIcon Print24}" Appearance="Primary" Command="{Binding PrintClosingCommand}" MinHeight="40"/>
</StackPanel>
<StackPanel><TextBlock Text="Cierre del día" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Closing.FirstLast}" Style="{StaticResource Hint}"/></StackPanel>
</DockPanel>

<UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,14">
<Border Background="{StaticResource StrongGradient}" CornerRadius="12" Padding="16,12" Margin="0,0,6,0">
<StackPanel><TextBlock Text="Total del día" FontSize="13" Foreground="White"/><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Closing.TotalMinor,Converter={StaticResource Money}}" FontSize="26" FontWeight="Bold" Foreground="White"/></Viewbox></StackPanel>
</Border>
<Border Style="{StaticResource StatCard}" Margin="6,0"><StackPanel><TextBlock Text="Ventas" FontSize="13" Foreground="{StaticResource MutedBrush}"/><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Closing.Count}" FontSize="26" FontWeight="Bold"/></Viewbox></StackPanel></Border>
<Border Style="{StaticResource StatCard}" Margin="6,0"><StackPanel><TextBlock Text="Ticket promedio" FontSize="13" Foreground="{StaticResource MutedBrush}"/><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Closing.Average}" FontSize="26" FontWeight="Bold"/></Viewbox></StackPanel></Border>
<Border Style="{StaticResource StatCard}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Anuladas" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
<Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock><Run Text="{Binding Closing.CancelledCount,Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DangerInkBrush}"/><Run Text="  "/><Run Text="{Binding Closing.CancelledMinor,Mode=OneWay,Converter={StaticResource Money}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerInkBrush}"/></TextBlock></Viewbox></StackPanel></Border>
</UniformGrid>

<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

<!-- Cobros y caja -->
<Border Style="{StaticResource Card}" Padding="18,16" CornerRadius="14">
<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
<StackPanel>
<TextBlock Text="Cobros por medio de pago" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
<ItemsControl ItemsSource="{Binding Closing.Payments}">
<ItemsControl.ItemTemplate><DataTemplate>
<StackPanel Margin="0,6">
<DockPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="Bold" FontSize="15"/>
<TextBlock><Run Text="{Binding Label,Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding CountLabel,Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="13"/></TextBlock>
</DockPanel>
<Grid Height="10" Margin="0,6,0,0">
<Border CornerRadius="5" Background="#EEF3F5"/>
<Border CornerRadius="5" Background="{StaticResource StrongGradient}" RenderTransformOrigin="0,0.5" ToolTip="{Binding Percent}">
<Border.RenderTransform><ScaleTransform ScaleX="{Binding Share}"/></Border.RenderTransform>
</Border>
</Grid>
</StackPanel>
</DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>

<Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
<DockPanel><TextBlock Text="{Binding Closing.CashMinor,Converter={StaticResource Money}}" DockPanel.Dock="Right" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessInkBrush}" Margin="10,0,0,0"/><TextBlock Text="Efectivo que debería haber en caja" FontWeight="SemiBold" Foreground="{StaticResource SuccessInkBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
</Border>

<TextBlock Text="Efectivo contado (opcional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
<DockPanel><TextBlock Text="$" DockPanel.Dock="Left" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/><ui:TextBox Text="{Binding CountedCash,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0,00" AutomationProperties.Name="Efectivo contado"/></DockPanel>
<Border CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
<Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource GroundBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers>
<DataTrigger Binding="{Binding CashDifferenceKind}" Value="ok"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource SuccessInkBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding CashDifferenceKind}" Value="over"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarningInkBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding CashDifferenceKind}" Value="short"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerInkBrush}"/></DataTrigger>
</Style.Triggers></Style></Border.Style>
<DockPanel><TextBlock Text="{Binding CashDifferenceAmount}" DockPanel.Dock="Right" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding CashDifferenceLabel}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
</Border>
<TextBlock Text="El conteo solo se usa para comparar y para el resumen impreso; no se guarda." Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0"/>
</StackPanel>
</ScrollViewer>
</Border>

<!-- Productos vendidos -->
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16" CornerRadius="14">
<DockPanel>
<TextBlock DockPanel.Dock="Top" Text="Productos vendidos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
<TextBlock DockPanel.Dock="Top" Text="No se vendieron productos este día." Style="{StaticResource Hint}" Visibility="{Binding NoSoldItemsVisibility}"/>
<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
<ItemsControl ItemsSource="{Binding Closing.Items}">
<ItemsControl.ItemTemplate><DataTemplate>
<Border BorderBrush="#EEF3F5" BorderThickness="0,0,0,1" Padding="0,9">
<DockPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold" Margin="8,0,0,0"/>
<TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Name,Mode=OneWay}"/><Run Text=" · " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Quantity,Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="13"/></TextBlock>
</DockPanel>
</Border>
</DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</ScrollViewer>
</DockPanel>
</Border>
</Grid>
</DockPanel>
</UserControl>
