<UserControl x:Class="POS.Desktop.Views.InventoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="Page">
<DockPanel Margin="26,16,26,22">
<DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
<ui:TextBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Text="{Binding InventorySearch,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Buscar producto" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Buscar en el inventario"/>
<TextBlock Text="Inventario" Style="{StaticResource PageTitle}"/>
</DockPanel>

<!-- Resumen por estado: cada tarjeta filtra la tabla -->
<UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,14">
<Button Style="{StaticResource SummaryCard}" Command="{Binding PickInventoryFilterCommand}" CommandParameter="REPONER" Margin="0,0,6,0" AutomationProperties.Name="Ver productos para reponer">
<StackPanel><TextBlock Text="Para reponer" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ReplenishCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerInkBrush}"/></StackPanel>
</Button>
<Button Style="{StaticResource SummaryCard}" Command="{Binding PickInventoryFilterCommand}" CommandParameter="BAJO" Margin="6,0" AutomationProperties.Name="Ver productos con stock bajo">
<StackPanel><TextBlock Text="Stock bajo" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding LowCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningInkBrush}"/></StackPanel>
</Button>
<Button Style="{StaticResource SummaryCard}" Command="{Binding PickInventoryFilterCommand}" CommandParameter="SUFICIENTE" Margin="6,0,0,0" AutomationProperties.Name="Ver productos con stock suficiente">
<StackPanel><TextBlock Text="Suficiente" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding EnoughCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessInkBrush}"/></StackPanel>
</Button>
</UniformGrid>

<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="0.75*" MinWidth="270" MaxWidth="380"/></Grid.ColumnDefinitions>

<DockPanel>
<ListBox DockPanel.Dock="Top" Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding InventoryFilters}" SelectedItem="{Binding InventoryFilterOption}" DisplayMemberPath="Label" Margin="0,0,0,2" AutomationProperties.Name="Filtrar por estado"/>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
<DockPanel>
<Grid DockPanel.Dock="Top" Margin="12,10,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" MinWidth="120"/><ColumnDefinition Width="1*" MinWidth="80"/><ColumnDefinition Width="0.8*" MinWidth="64"/><ColumnDefinition Width="1*" MinWidth="100"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="PRODUCTO" Style="{StaticResource TableHeader}"/><TextBlock Grid.Column="1" Text="EXISTENCIAS" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="MÍNIMO" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" Margin="0,0,8,0"/><TextBlock Grid.Column="3" Text="ESTADO" Style="{StaticResource TableHeader}"/></Grid>
<Grid>
<ListBox Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}" ItemsSource="{Binding FilteredInventory}" SelectedItem="{Binding SelectedInventory}" AutomationProperties.Name="Existencias">
<ListBox.ItemTemplate><DataTemplate>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" MinWidth="120"/><ColumnDefinition Width="1*" MinWidth="80"/><ColumnDefinition Width="0.8*" MinWidth="64"/><ColumnDefinition Width="1*" MinWidth="100"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
<TextBlock Grid.Column="1" Text="{Binding Quantity}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,0,8,0"/>
<TextBlock Grid.Column="2" Text="{Binding Minimum}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#3E5A64" Margin="0,0,8,0"/>
<Border Grid.Column="3" Style="{StaticResource StockPill}" Tag="{Binding StatusKind}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,2" Margin="8,0,0,0"><TextBlock Text="{Binding StatusLabel}" FontSize="12"/></Border>
</Grid>
</DataTemplate></ListBox.ItemTemplate>
</ListBox>
<TextBlock Text="No hay productos con ese estado." Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding NoInventoryVisibility}"/>
</Grid>
</DockPanel>
</Border>
</DockPanel>

<!-- Detalle del producto elegido -->
<Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14">
<Grid>
<StackPanel Visibility="{Binding NoDetailVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
<Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource SidebarGradient}" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="BoxCheckmark24" FontSize="28" Foreground="{StaticResource PrimaryBrush}"/></Border>
<TextBlock Text="Elegí un producto" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
<TextBlock Text="Vas a poder reponer, corregir existencias, fijar un mínimo y ver sus movimientos." Style="{StaticResource Hint}" TextAlignment="Center"/>
</StackPanel>
<ScrollViewer Visibility="{Binding DetailVisibility}" VerticalScrollBarVisibility="Auto" Focusable="False">
<StackPanel Margin="18,16">
<TextBlock Text="{Binding SelectedInventory.Subtitle}" Style="{StaticResource Hint}" FontSize="12"/>
<TextBlock Text="{Binding SelectedInventory.Name}" Style="{StaticResource SectionTitle}" FontSize="20" TextWrapping="Wrap"/>
<Border Background="{StaticResource SidebarGradient}" CornerRadius="12" Padding="14,12" Margin="0,12,0,0">
<DockPanel>
<Border DockPanel.Dock="Right" Style="{StaticResource StockPill}" Tag="{Binding SelectedInventory.StatusKind}" VerticalAlignment="Center" Padding="10,2"><TextBlock Text="{Binding SelectedInventory.StatusLabel}" FontSize="12"/></Border>
<StackPanel>
<TextBlock Text="Existencias" FontSize="13" Foreground="#3E5A64"/>
<TextBlock FontWeight="Bold" Foreground="{StaticResource InkBrush}">
<TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="Text" Value="{Binding SelectedInventory.Quantity}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedInventory.IsManual}" Value="True"><Setter Property="Text" Value="Control manual"/><Setter Property="FontSize" Value="20"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
</TextBlock>
</StackPanel>
</DockPanel>
</Border>

<!-- Stock medible -->
<StackPanel Visibility="{Binding MeasurableVisibility}" Margin="0,14,0,0">
<UniformGrid Rows="1">
<RadioButton Style="{StaticResource Segment}" Content="Reponer (+)" IsChecked="{Binding IsRestock}" GroupName="StockKind" Margin="0,0,4,0"/>
<RadioButton Style="{StaticResource Segment}" Content="Fijar valor" IsChecked="{Binding IsAbsoluteStock}" GroupName="StockKind" Margin="4,0,0,0" ToolTip="Para corregir después de un recuento"/>
</UniformGrid>
<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Cantidad" Style="{StaticResource FieldLabel}"/>
<DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding StockUnitLabel}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/><ui:TextBox Text="{Binding StockQuantity,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0" AutomationProperties.Name="Cantidad"/></DockPanel></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Motivo" Style="{StaticResource FieldLabel}"/><ui:TextBox Text="{Binding StockNote,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motivo"/></StackPanel>
</Grid>
<ui:Button Content="{Binding StockActionLabel}" Appearance="Primary" Command="{Binding StockCommand}" HorizontalAlignment="Stretch" MinHeight="44" FontWeight="Bold" Margin="0,12,0,0"/>
<Border BorderBrush="#E7EEF1" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
<StackPanel>
<TextBlock Text="Mínimo para avisar reposición" Style="{StaticResource FieldLabel}"/>
<DockPanel>
<ui:Button DockPanel.Dock="Right" Content="Guardar" Command="{Binding MinimumCommand}" MinHeight="36" Margin="8,0,0,0"/>
<TextBlock DockPanel.Dock="Right" Text="{Binding StockUnitLabel}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/>
<ui:TextBox Text="{Binding MinimumQuantity,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Sin mínimo" AutomationProperties.Name="Mínimo"/>
</DockPanel>
<TextBlock Text="Con existencias iguales o menores al mínimo, el producto pasa a «Bajo»." Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0"/>
</StackPanel>
</Border>
</StackPanel>

<!-- Estado manual -->
<StackPanel Visibility="{Binding ManualVisibility}" Margin="0,14,0,0">
<TextBlock Text="Este producto no descuenta existencias. Marcá su estado de reposición:" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
<UniformGrid Rows="1">
<ui:Button Content="Suficiente" Command="{Binding ManualStatusCommand}" CommandParameter="SUFICIENTE" HorizontalAlignment="Stretch" MinHeight="40" Margin="0,0,4,0"/>
<ui:Button Content="Bajo" Command="{Binding ManualStatusCommand}" CommandParameter="BAJO" HorizontalAlignment="Stretch" MinHeight="40" Margin="4,0"/>
<ui:Button Content="Reponer" Command="{Binding ManualStatusCommand}" CommandParameter="REPONER" HorizontalAlignment="Stretch" MinHeight="40" Margin="4,0,0,0"/>
</UniformGrid>
</StackPanel>

<!-- Movimientos -->
<TextBlock Text="Últimos movimientos" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,18,0,6"/>
<TextBlock Text="Todavía no hay movimientos." Style="{StaticResource Hint}" Visibility="{Binding NoMovementsVisibility}"/>
<ItemsControl ItemsSource="{Binding Movements}">
<ItemsControl.ItemTemplate><DataTemplate>
<Border BorderBrush="#EEF3F5" BorderThickness="0,1,0,0" Padding="0,8">
<DockPanel>
<Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{StaticResource MutedBrush}"/>
<TextBlock x:Name="Qty" DockPanel.Dock="Right" Text="{Binding Quantity}" FontWeight="Bold" FontSize="13" Margin="8,0,0,0" Foreground="{StaticResource InkBrush}"/>
<StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
</DockPanel>
</Border>
<DataTemplate.Triggers>
<DataTrigger Binding="{Binding Kind}" Value="in"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/><Setter TargetName="Qty" Property="Foreground" Value="{StaticResource SuccessInkBrush}"/></DataTrigger>
<DataTrigger Binding="{Binding Kind}" Value="out"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerInkBrush}"/><Setter TargetName="Qty" Property="Foreground" Value="{StaticResource DangerInkBrush}"/></DataTrigger>
</DataTemplate.Triggers>
</DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</ScrollViewer>
</Grid>
</Border>
</Grid>
</DockPanel>
</UserControl>
