<UserControl x:Class="POS.Desktop.Views.InventoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
<Grid Margin="26,16,26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/></Grid.RowDefinitions>
<TextBlock Text="Inventario" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
<ui:DataGrid Grid.Row="1" ItemsSource="{Binding Inventory}" SelectedItem="{Binding SelectedInventory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Row.Name}" Width="*"/><DataGridTextColumn Header="Existencias" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" MinWidth="130"/></DataGrid.Columns></ui:DataGrid>
<Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14"><StackPanel>
<WrapPanel><TextBlock Text="Cantidad (kg, unidades o packs)" VerticalAlignment="Center" Margin="0,0,8,0"/><ui:TextBox Width="110" Text="{Binding StockQuantity}"/><TextBlock Text="Motivo" VerticalAlignment="Center" Margin="12,0,8,0"/><ui:TextBox Width="220" Text="{Binding StockNote}"/><ui:Button Content="Reponer" Appearance="Primary" Command="{Binding RestockCommand}" Margin="12,0,8,0"/><ui:Button Content="Establecer stock" Command="{Binding AdjustStockCommand}"/></WrapPanel>
<WrapPanel Margin="0,10,0,0"><TextBlock Text="Mínimo" VerticalAlignment="Center" Margin="0,0,8,0"/><ui:TextBox Width="100" Text="{Binding MinimumQuantity}"/><ui:Button Content="Guardar mínimo" Command="{Binding MinimumStockCommand}" Margin="8,0,0,0"/><TextBlock Text="Reposición manual" VerticalAlignment="Center" Margin="16,0,8,0"/><ComboBox Width="180" ItemsSource="{Binding Statuses}" SelectedItem="{Binding ManualStatus}"/><ui:Button Content="Guardar estado" Command="{Binding ManualStatusCommand}" Margin="8,0"/><ui:Button Content="Ver movimientos" Command="{Binding MovementsCommand}"/></WrapPanel>
</StackPanel></Border>
<ui:DataGrid Grid.Row="3" ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}"/><DataGridTextColumn Header="Movimiento" Binding="{Binding Type}"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Motivo" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></ui:DataGrid>
</Grid>
</UserControl>
