<UserControl x:Class="POS.Desktop.Views.SalePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="Page">
<Grid Margin="26,16,26,22">
<Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="22"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>

<!-- Catálogo -->
<DockPanel>
<DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
<TextBlock DockPanel.Dock="Right" Text="{Binding TodayLabel}" Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
<TextBlock Text="Nueva venta" Style="{StaticResource PageTitle}"/>
</DockPanel>
<Grid DockPanel.Dock="Top">
<ui:TextBox x:Name="SaleSearch" Text="{Binding SaleSearch,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Buscá por nombre o escaneá el código" Icon="{ui:SymbolIcon Search24}" FontSize="16" MinHeight="50" Padding="10,12,56,12" ClearButtonEnabled="False" PreviewKeyDown="SearchKeyDown" AutomationProperties.Name="Buscar producto. Enter agrega el primer resultado"/>
<Border HorizontalAlignment="Right" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="F2" FontSize="12" Foreground="{StaticResource MutedBrush}"/></Border>
</Grid>
<ListBox DockPanel.Dock="Top" Margin="0,14,0,6" Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SaleCategory}" AutomationProperties.Name="Filtrar por categoría"/>
<TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Enter agrega el primer resultado. Los productos por peso piden la cantidad en kg (ej.: 0,5)."/>
<Grid>
<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" ScrollChanged="CatalogScrollChanged">
<ItemsControl ItemsSource="{Binding SaleProducts}" Focusable="False" AutomationProperties.Name="Productos">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate>
<Button Style="{StaticResource ProductTile}" Width="{Binding TileWidth,ElementName=Page}" Command="{Binding DataContext.AddProductCommand,ElementName=Page}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
<DockPanel>
<DockPanel DockPanel.Dock="Top">
<Border DockPanel.Dock="Right" Style="{StaticResource StockPill}" Tag="{Binding StockKind}"><TextBlock Text="{Binding StockLabel}"/></Border>
<TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
</DockPanel>
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
<TextBlock Text="{Binding Price}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
<TextBlock Text="{Binding UnitLabel,StringFormat=' / {0}'}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
</StackPanel>
<TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,4"/>
</DockPanel>
</Button>
</DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</ScrollViewer>
<StackPanel Visibility="{Binding NoResultsVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center">
<ui:SymbolIcon Symbol="BoxSearch24" FontSize="40" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
<TextBlock Text="No hay productos que coincidan." Style="{StaticResource Hint}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
</StackPanel>
</Grid>
</DockPanel>

<!-- Carrito -->
<Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14">
<DockPanel>
<DockPanel DockPanel.Dock="Top" Margin="18,14,12,12">
<Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Command="{Binding ClearCartCommand}" Foreground="{StaticResource DangerInkBrush}" FontWeight="SemiBold" Content="Vaciar"/>
<TextBlock VerticalAlignment="Center"><Run Text="Carrito" FontSize="18" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding CartCountLabel,Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
</DockPanel>

<StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
<ListBox Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource PaymentChip}" ItemsSource="{Binding Payments}" SelectedItem="{Binding Payment}" DisplayMemberPath="Label" AutomationProperties.Name="Medio de pago">
<ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
</ListBox>
<Border Background="{StaticResource StrongGradient}" CornerRadius="12" Padding="18,14" Margin="0,12,0,0">
<StackPanel>
<DockPanel><TextBlock Text="Total" Foreground="White" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{Binding Total}" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel>
<Button Command="{Binding CheckoutCommand}" Margin="0,12,0,0" MinHeight="52" HorizontalAlignment="Stretch" Cursor="Hand" AutomationProperties.Name="Cobrar (F12)">
<Button.Template><ControlTemplate TargetType="Button">
<Border x:Name="Bd" CornerRadius="10" Background="White" BorderThickness="2" BorderBrush="White"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F0FAFC"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBrush}"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate></Button.Template>
<StackPanel Orientation="Horizontal">
<TextBlock Text="Cobrar" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
<Border BorderBrush="#9CC9D6" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="F12" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/></Border>
</StackPanel>
</Button>
</StackPanel>
</Border>
</StackPanel>

<Grid>
<ListBox x:Name="CartList" Style="{StaticResource CartList}" ItemContainerStyle="{StaticResource CartLine}" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCart}" PreviewKeyDown="CartKeyDown" AutomationProperties.Name="Líneas del carrito. Más y menos cambian la cantidad, Suprimir quita la línea">
<ListBox.ItemTemplate><DataTemplate>
<StackPanel>
<DockPanel>
<TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontWeight="Bold" FontSize="15" Margin="10,0,0,0"/>
<StackPanel>
<TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding UnitPriceLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
</StackPanel>
</DockPanel>
<DockPanel Margin="0,8,0,0">
<Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Command="{Binding DataContext.RemoveLineCommand,ElementName=Page}" CommandParameter="{Binding}" AutomationProperties.Name="Quitar del carrito" ToolTip="Quitar (Supr)"><ui:SymbolIcon Symbol="Delete24" FontSize="18"/></Button>
<Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left" ClipToBounds="True">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource StepButton}" Content="−" Command="{Binding DataContext.DecrementCommand,ElementName=Page}" CommandParameter="{Binding}" AutomationProperties.Name="Restar" ToolTip="Restar (−)"/>
<Button Style="{StaticResource QuietButton}" MinWidth="84" Command="{Binding DataContext.EditLineCommand,ElementName=Page}" CommandParameter="{Binding}" AutomationProperties.Name="Cambiar cantidad" ToolTip="Cambiar cantidad"><TextBlock Text="{Binding ShortQuantity}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/></Button>
<Button Style="{StaticResource StepButton}" Content="+" Command="{Binding DataContext.IncrementCommand,ElementName=Page}" CommandParameter="{Binding}" AutomationProperties.Name="Sumar" ToolTip="Sumar (+)"/>
</StackPanel>
</Border>
</DockPanel>
</StackPanel>
</DataTemplate></ListBox.ItemTemplate>
</ListBox>
<StackPanel Visibility="{Binding EmptyCartVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
<Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource SidebarGradient}" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Cart24" FontSize="28" Foreground="{StaticResource PrimaryBrush}"/></Border>
<TextBlock Text="El carrito está vacío" Style="{StaticResource SectionTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
<TextBlock Text="Buscá un producto o tocá una tarjeta para agregarlo." Style="{StaticResource Hint}" TextAlignment="Center"/>
</StackPanel>
</Grid>
</DockPanel>
</Border>
</Grid>
</UserControl>
