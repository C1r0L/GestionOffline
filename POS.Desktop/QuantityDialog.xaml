<ui:FluentWindow x:Class="POS.Desktop.QuantityDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Cantidad" Width="420" Height="300" MinHeight="0" MinWidth="0" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{StaticResource SurfaceBrush}">
<StackPanel x:Name="Root">
<ui:TitleBar ShowMinimize="False" ShowMaximize="False" ShowHelp="False" CanMaximize="False"/>
<StackPanel Margin="24,0,24,18">
<TextBlock x:Name="ProductName" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
<TextBlock x:Name="UnitPrice" Style="{StaticResource Hint}" Margin="0,2,0,14"/>
<TextBlock x:Name="FieldName" Style="{StaticResource FieldLabel}"/>
<DockPanel>
<TextBlock x:Name="Suffix" DockPanel.Dock="Right" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}"/>
<ui:TextBox x:Name="Input" FontSize="20" TextChanged="InputChanged" AutomationProperties.Name="Cantidad"/>
</DockPanel>
<TextBlock x:Name="Help" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
<Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
<DockPanel><TextBlock Text="Importe" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="Amount" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></DockPanel>
</Border>
<TextBlock x:Name="Error" Foreground="{StaticResource DangerInkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Hidden"/>
</StackPanel>
<Border Background="#F8FBFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<ui:Button Content="Cancelar" IsCancel="True" MinWidth="110" MinHeight="40" Margin="0,0,8,0" Click="CancelClick"/>
<ui:Button x:Name="ConfirmButton" Content="Agregar" Appearance="Primary" IsDefault="True" MinWidth="130" MinHeight="40" Click="ConfirmClick"/>
</StackPanel>
</Border>
</StackPanel>
</ui:FluentWindow>
